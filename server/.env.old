# ============================================================
# CONFIGURACIÓN DEL SERVIDOR - copiar este archivo como ".env"
# (setup.bat lo hace automáticamente)
# ============================================================

# Puerto del backend
PORT=4000

# --- Base de datos MySQL local ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=tavo_ecommerce

# --- Seguridad ---
# Cambiar por una cadena larga y aleatoria (es la firma de los tokens de sesión)
JWT_SECRET=bV=];xXJ+/W!-U/Y|G66EUdBkuhn%^x#t}rG$}hgypN

# --- Mercado Pago ---
# Access Token de la cuenta de Mercado Pago QUE RECIBE EL DINERO (la de tu viejo).
# Se obtiene en: https://www.mercadopago.com.ar/developers/panel/app
# -> Crear aplicación -> Credenciales de producción -> Access Token
# Para probar sin plata real usar las "Credenciales de prueba" (empiezan con TEST-)
MP_ACCESS_TOKEN=APP_USR-2463195826534502-061220-e7289850ec9043e2509542b4ce908f1b-3470890938

# --- URLs ---
# URL pública del backend (para que Mercado Pago notifique los pagos).
# En localhost los webhooks NO llegan: la app igual confirma el pago cuando
# el usuario vuelve a la página. Cuando tengas dominio/IP pública, ponela acá.
PUBLIC_URL=https://emblem-crushed-fanatic.ngrok-free.dev

# URL del frontend (a dónde vuelve el usuario después de pagar)
FRONTEND_URL=https://emblem-crushed-fanatic.ngrok-free.dev
